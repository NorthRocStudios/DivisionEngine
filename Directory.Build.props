<Project>

  <!--
    Project files sign their output with $(SolutionDir)DivisionKey.snk. MSBuild only
    defines SolutionDir when a .sln is built; building a single project directly
    (dotnet build on a .csproj, DocFX metadata, CI) leaves it empty, so the key path
    becomes just "DivisionKey.snk" relative to the project folder and signing fails.
    Default it to the repository root.
  -->
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
  </PropertyGroup>

  <!--
    Emit XML documentation files for every project: IDEs use them for IntelliSense
    and DocFX uses them to build the API reference site. CS1591 (missing XML comment)
    is suppressed so partially documented types do not spam the build log.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>

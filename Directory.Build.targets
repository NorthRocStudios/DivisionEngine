<Project>

  <!--
    DivisionKey.snk is not committed to the repository, so a fresh clone or a CI
    runner has no strong-name key. Skip assembly signing instead of failing the
    build when the key file is missing (local dev machines still sign normally).
  -->
  <PropertyGroup Condition="'$(SignAssembly)' == 'true' and !Exists('$(AssemblyOriginatorKeyFile)')">
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

</Project>

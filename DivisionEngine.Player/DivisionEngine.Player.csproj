<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>DivisionEngine.Player.GameStartup</StartupObject>
    <ApplicationIcon>DivisionEngineLogoRAIS.ico</ApplicationIcon>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(SolutionDir)DivisionKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="DivisionEngineLogoRAIS.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ComputeSharp" Version="3.2.0" />
    <PackageReference Include="NorthRoc.DivisionMath" Version="0.1.0" />
    <PackageReference Include="Silk.NET" Version="2.23.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DivisionEngine.Core\DivisionEngine.Core.csproj" />
  </ItemGroup>

</Project>

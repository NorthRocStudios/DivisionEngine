<local:EditorWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:DivisionEngine.Editor"
                    xmlns:vm="using:DivisionEngine.Editor.ViewModels"
                    xmlns:icons="using:Material.Icons.Avalonia"
                    mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
                    x:Class="DivisionEngine.Editor.NodeEditorWindow"
                    x:DataType="vm:NodeEditorWindowViewModel">
  <local:EditorWindow.Styles>
    <Style Selector="Button.node-tool">
      <Setter Property="Background" Value="#2E2E2E"/>
      <Setter Property="Foreground" Value="#C8C8C8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.node-tool">
      <Setter Property="Background" Value="#2E2E2E"/>
      <Setter Property="Foreground" Value="#C8C8C8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.node-tool:pointerover">
      <Setter Property="Background" Value="#454545"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.node-tool:pointerover">
      <Setter Property="Background" Value="#454545"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.node-tool:disabled">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.node-accent">
      <Setter Property="Background" Value="#2C2C2C"/>
      <Setter Property="Foreground" Value="#D8D8D8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.node-accent:pointerover">
      <Setter Property="Background" Value="#3D3D3D"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ListBoxItem.node-search-item">
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBoxItem.node-search-item:selected">
      <Setter Property="Background" Value="#3C4B5A"/>
    </Style>
  </local:EditorWindow.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Background="#222222">
    <!-- Toolbar -->
    <Border Grid.Row="0" Background="#3A3A3A" BorderBrush="#222222"
            BorderThickness="0,0,0,1" Padding="10,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <icons:MaterialIcon Kind="{Binding Icon}" Width="17" Height="17" Foreground="#888888"
                              VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#DDDDDD"
                     VerticalAlignment="Center"/>
          <TextBlock Text="{Binding DirtyMarker}" FontSize="12" Foreground="#D0A060" VerticalAlignment="Center"/>
          <Border Background="#2C2C2C" CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
            <TextBlock Text="{Binding GraphSummary}" FontSize="10" Foreground="#AAAAAA"/>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <Button Classes="node-tool" Click="OnOpenGraphClick" ToolTip.Tip="Open graph (Ctrl+O)">
            <icons:MaterialIcon Kind="FolderOpen" Width="12" Height="12"/>
          </Button>
          <Button Classes="node-tool" Click="OnSaveGraphClick" ToolTip.Tip="Save graph (Ctrl+S)">
            <icons:MaterialIcon Kind="ContentSave" Width="12" Height="12"/>
          </Button>
          <Rectangle Width="1" Height="18" Fill="#555555" Margin="2,0"/>
          <Button Classes="node-tool" Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)">
            <icons:MaterialIcon Kind="Undo" Width="12" Height="12"/>
          </Button>
          <Button Classes="node-tool" Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)">
            <icons:MaterialIcon Kind="Redo" Width="12" Height="12"/>
          </Button>
          <Rectangle Width="1" Height="18" Fill="#555555" Margin="2,0"/>
          <Button Classes="node-tool" Command="{Binding OpenNodeSearchPanelCommand}"
                  ToolTip.Tip="Add node (Space)">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <icons:MaterialIcon Kind="Plus" Width="12" Height="12" VerticalAlignment="Center"/>
              <TextBlock Text="Add Node" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="node-tool" Command="{Binding FrameAllNodesCommand}" ToolTip.Tip="Frame all (Home)">
            <icons:MaterialIcon Kind="FitToScreen" Width="12" Height="12"/>
          </Button>
          <Button Classes="node-tool" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out">
            <icons:MaterialIcon Kind="MagnifyMinus" Width="12" Height="12"/>
          </Button>
          <Border Background="#2C2C2C" CornerRadius="3" Padding="6,4" MinWidth="48">
            <TextBlock Text="{Binding ZoomText}" FontSize="10" Foreground="#BBBBBB"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button Classes="node-tool" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in">
            <icons:MaterialIcon Kind="MagnifyPlus" Width="12" Height="12"/>
          </Button>
          <Rectangle Width="1" Height="18" Fill="#555555" Margin="2,0"/>
          <Button Classes="node-tool" Command="{Binding EvaluateCommand}" ToolTip.Tip="Evaluate the graph">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <icons:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="#BFFF00" VerticalAlignment="Center"/>
              <TextBlock Text="Evaluate" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <ToggleButton Classes="node-tool" IsChecked="{Binding ShowInspector, Mode=TwoWay}"
                        ToolTip.Tip="Toggle inspector">
            <icons:MaterialIcon Kind="DockRight" Width="13" Height="13"/>
          </ToggleButton>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Canvas + inspector -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Grid Grid.Column="0">
        <local:NodeGraphCanvas x:Name="GraphCanvas"/>

        <!-- Add node search panel -->
        <Border x:Name="NodeSearchOverlay" IsVisible="{Binding IsNodeSearchOpen}"
                Width="360" MaxHeight="430" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16" Background="#333333" BorderBrush="#111111" BorderThickness="1"
                CornerRadius="6" Padding="8">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBox x:Name="NodeSearchBox" PlaceholderText="Search nodes…"
                     Text="{Binding NodeSearchText, Mode=TwoWay}" KeyDown="OnSearchKeyDown"
                     FontSize="12" Background="#202020" Foreground="#DDDDDD" BorderThickness="1"
                     BorderBrush="#555555" CornerRadius="3" Padding="6,4"/>
            <TextBlock Grid.Row="1" Text="{Binding NodeSearchStatus}" FontSize="10" Foreground="#888888"
                       Margin="2,6,2,4"/>
            <ScrollViewer Grid.Row="2" MaxHeight="330" VerticalScrollBarVisibility="Auto">
              <ListBox x:Name="NodeSearchList" ItemsSource="{Binding SearchResults}"
                       SelectionChanged="OnSearchSelectionChanged"
                       Background="Transparent" BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:NodeCatalogEntryViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                      <icons:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="14" Height="14"
                                         Foreground="#8AA0B0" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Spacing="0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="#DDDDDD"/>
                        <TextBlock Text="{Binding MenuPath}" FontSize="9" Foreground="#888888"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Category}" FontSize="9" Foreground="#666666"
                                 VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Inspector -->
      <Border Grid.Column="1" Width="296" Background="#252525" BorderBrush="#222222"
              BorderThickness="1,0,0,0" IsVisible="{Binding ShowInspector}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="InspectorPanel" Margin="10,10,10,16" Spacing="6"/>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#303030" BorderBrush="#222222" BorderThickness="0,1,0,0"
            Padding="10,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#999999"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="1" Text="{Binding EvaluationSummary}" FontSize="10"
                   Foreground="#BBBBBB"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectionSummary}" FontSize="10" Foreground="#888888"/>
          <TextBlock Text="{Binding ZoomText}" FontSize="10" Foreground="#BBBBBB"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</local:EditorWindow>

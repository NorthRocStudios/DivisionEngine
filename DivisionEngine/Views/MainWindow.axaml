<Window xmlns="https://github.com/avaloniaui"
        xmlns:icons="using:Material.Icons.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DivisionEngine.Editor.ViewModels"
        xmlns:local="using:DivisionEngine.Editor"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="DivisionEngine.Editor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/DivisionEngineLogoRAS.ico"
        Title="Division Engine" Background="#111" Foreground="#ccc">
  <!--Editor Window Templates-->
  <!--DO NOT FORGET TO PUT CUSTOM WINDOWS HERE!-->
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type local:ViewModels.WorldWindowViewModel}">
      <local:WorldWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.AssetsWindowViewModel}">
      <local:AssetsWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.ConsoleWindowViewModel}">
      <local:ConsoleWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.EnvironmentWindowViewModel}">
      <local:EnvironmentWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.PropertiesWindowViewModel}">
      <local:PropertiesWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.SettingsWindowViewModel}">
      <local:SettingsWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.DeveloperWindowViewModel}">
      <local:DeveloperWindow/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type local:ViewModels.SdfPlaygroundExampleViewModel}">
      <local:NodeEditorWindow/>
    </DataTemplate>
  </Window.DataTemplates>

  <!--Main Window-->
  <DockPanel Background="#333">
    <!--Main Menu-->
    <StackPanel DockPanel.Dock="Top" Background="#444" Orientation="Horizontal">
      <TextBlock Text="Division Engine" FontWeight="Bold" FontSize="16" Margin="5" VerticalAlignment="Center"/>
        <Menu Foreground="#ccc" IsTextSearchEnabled="True">
            <!--File / Edit Menu-->
        <MenuItem x:Name="FileMenu" Header="File" Foreground="#ccc">
            <MenuItem Header="New" Command="{Binding NewProjectCommand}" Foreground="#ccc"/>
            <MenuItem Header="Open" Command="{Binding OpenProjectCommand}" Foreground="#ccc"/>

            <!-- Recent Projects Submenu -->
            <MenuItem Header="Recent Projects" Foreground="#ccc" IsEnabled="{Binding HasRecentProjects}"
                        ItemsSource="{Binding RecentProjectMenuItems}">
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="Recent Projects"/>
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
            </MenuItem>
            <Separator/>

            <MenuItem Header="Save" Command="{Binding SaveProjectCommand}" Foreground="#ccc"/>
            <MenuItem Header="Save As" Command="{Binding SaveProjectAsCommand}" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Exit" Command="{Binding ExitCommand}" Foreground="#ccc"/>
        </MenuItem>
        <MenuItem Header="Edit" Foreground="#ccc">
            <MenuItem Header="Undo" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Foreground="#ccc"/>
            <MenuItem Header="Redo" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Reload Textures" Command="{Binding ReloadTexturesCommand}" Foreground="#ccc"/>
            <MenuItem Header="Reload All Shaders" Command="{Binding ReloadAllShadersCommand}" Foreground="#ccc"/>
        </MenuItem>
            <!--Add Entity Menu-->
        <MenuItem Header="Add" Foreground="#ccc">
            <MenuItem Header="Empty Entity" Command="{Binding CreateEntityCommand}" CommandParameter="empty" Foreground="#ccc"/>
            <MenuItem Header="Empty Transform" Command="{Binding CreateEntityCommand}" CommandParameter="emptyTransform" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Camera" Command="{Binding CreateEntityCommand}" CommandParameter="camera" Foreground="#ccc"/>
            <MenuItem Header="Environment" Command="{Binding CreateEntityCommand}" CommandParameter="environment" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Directional Light" Command="{Binding CreateEntityCommand}" CommandParameter="directionalLight" Foreground="#ccc"/>
            <MenuItem Header="Point Light" Command="{Binding CreateEntityCommand}" CommandParameter="pointLight" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Sphere" Command="{Binding CreateEntityCommand}" CommandParameter="sphere" Foreground="#ccc"/>
            <MenuItem Header="Box" Command="{Binding CreateEntityCommand}" CommandParameter="box" Foreground="#ccc"/>
            <MenuItem Header="Rounded Box" Command="{Binding CreateEntityCommand}" CommandParameter="roundedBox" Foreground="#ccc"/>
            <MenuItem Header="Donut" Command="{Binding CreateEntityCommand}" CommandParameter="torus" Foreground="#ccc"/>
            <MenuItem Header="Pyramid" Command="{Binding CreateEntityCommand}" CommandParameter="pyramid" Foreground="#ccc"/>
            <MenuItem Header="Plane" Command="{Binding CreateEntityCommand}" CommandParameter="plane" Foreground="#ccc"/>
            <MenuItem Header="Cylinder" Command="{Binding CreateEntityCommand}" CommandParameter="cylinder" Foreground="#ccc"/>
            <MenuItem Header="Capsule" Command="{Binding CreateEntityCommand}" CommandParameter="capsule" Foreground="#ccc"/>
            <MenuItem Header="Cone" Command="{Binding CreateEntityCommand}" CommandParameter="cone" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Terrain" Command="{Binding CreateEntityCommand}" CommandParameter="terrain" Foreground="#ccc"/>
        </MenuItem>
            <!--Layouts Menu-->
        <MenuItem Header="Layouts" IsEnabled="{Binding LayoutsEnabled}" Foreground="#ccc">
            <MenuItem Header="Default" Command="{Binding ApplyDefaultLayoutCommand}" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Focus Editor" Command="{Binding ApplyFocusEditorLayoutCommand}" Foreground="#ccc"/>
            <MenuItem Header="Focus Assets" Command="{Binding ApplyFocusAssetsLayoutCommand}" Foreground="#ccc"/>
            <MenuItem Header="Wide Viewport" Command="{Binding ApplyWideViewportLayoutCommand}" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Minimal" Command="{Binding ApplyMinimalLayoutCommand}" Foreground="#ccc"/>
            <MenuItem Header="Debug" Command="{Binding ApplyDebugLayoutCommand}" Foreground="#ccc"/>
        </MenuItem>
            <!--Other Menus-->
        <MenuItem x:Name="ViewMenu" Header="View" Foreground="#ccc"/>
        <MenuItem Header="Logs" Foreground="#ccc">
            <MenuItem Header="Open Log Directory" Command="{Binding OpenLogDirectoryCommand}" Foreground="#ccc"/>
            <MenuItem Header="Open Current Log File" Command="{Binding OpenLogFileCommand}" Foreground="#ccc"/>
        </MenuItem>
        <MenuItem Header="Help" Foreground="#ccc">
            <MenuItem Header="About" Command="{Binding AboutCommand}" Foreground="#ccc"/>
            <MenuItem Header="Roadmap" Command="{Binding RoadmapCommand}" Foreground="#ccc"/>
            <MenuItem Header="Forum" Command="{Binding ForumCommand}" Foreground="#ccc"/>
            <Separator/>
            <MenuItem Header="Check Out Our Website!" Command="{Binding NorthRocCommand}" Foreground="#ccc"/>
        </MenuItem>
        </Menu>
    
        <!-- Vertical Separator Line -->
        <Rectangle Width="2" Height="24" Fill="#666" Margin="10,0" VerticalAlignment="Center"/>

        <!-- Play Controls Toolbar -->
        <Border Height="34">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4, 0, 4, 0">
                <!-- Play/Stop Button -->
                <Button x:Name="PlayButton" Width="32" Height="28" Margin="0" Padding="0" Background="#222"
                        BorderThickness="0, 0, 0, 2" BorderBrush="#111" CornerRadius="8, 0, 0, 8" Cursor="Hand">
                    <Button.Content>
                        <icons:MaterialIcon x:Name="PlayIcon" Kind="Play" Width="16" Height="16" Foreground="#bfff00"/>
                    </Button.Content>
                </Button>
            
                <!-- Pause/Resume Button -->
                <Button x:Name="PauseButton" Width="32" Height="28" Margin="0" Padding="0" Background="#222"
                        BorderThickness="0, 0, 0, 2" BorderBrush="#111" CornerRadius="0" Cursor="Hand">
                    <Button.Content>
                        <icons:MaterialIcon x:Name="PauseIcon" Kind="Pause" Width="16" Height="16" Foreground="#fb2"/>
                    </Button.Content>
                </Button>
            
                <!-- Advance Frame Button (only enabled when paused) -->
                <Button x:Name="AdvanceFrameButton" Width="32" Height="28" Margin="0" Padding="0" Background="#222" 
                        BorderThickness="0, 0, 2, 2" BorderBrush="#111" CornerRadius="0, 8, 8, 0" Cursor="Hand" IsEnabled="False">
                    <Button.Content>
                        <icons:MaterialIcon Kind="StepForward" Width="16" Height="16" Foreground="#bfff00"/>
                    </Button.Content>
                </Button>
            
                <!-- Game Mode Indicator -->
                <Border x:Name="GameModeIndicator" CornerRadius="4" Padding="8,4" Margin="12,0,0,0">
                    <TextBlock x:Name="GameModeText" Text="Editing" FontSize="11" FontWeight="Bold" 
                               Foreground="#888" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>

   <!--Bottom Utility Bar-->
    <Grid DockPanel.Dock="Bottom" Background="#444" Height="24">
        <!--Recent Controls Block-->
        <TextBlock x:Name="RecentControlsText" Text="{Binding RecentControlsText}" FontSize="12" Foreground="#BBB"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18, 0, 0, 0"/>

        <!--Progress Bar And Text-->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Width="200">
            <Border x:Name="ProgressBarContainer" Background="Transparent" CornerRadius="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ProgressBar x:Name="UniversalProgressBar" Height="18" Background="#111" Margin="0,0,8,0"
                             Foreground="#FF6A00" Cursor="Hand" IsHitTestVisible="True"/>
            </Border>
        
            <!--Text Overlays-->
            <TextBlock x:Name="ProgressPercentageText" Text="0%" FontSize="10" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                       IsVisible="{Binding #UniversalProgressBar.IsVisible}"/>
            <TextBlock x:Name="TaskCountText" Text="0" FontSize="10" Foreground="White"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"
                       IsVisible="{Binding #UniversalProgressBar.IsVisible}"/>
        </Grid>
    </Grid>

    <!--Basic Grid Layout-->
    <Grid x:Name="MainGrid" ColumnDefinitions="*, 2, 300">
      <Grid Grid.Column="0" x:Name="LeftCenterBottomGrid" RowDefinitions="*, 2, 250">
        <Grid Grid.Row="0" x:Name="LeftCenterGrid" ColumnDefinitions="200, 2, *">
          <!--Left Tabs-->
          <Grid Grid.Column="0" x:Name="LeftPanelGrid">
            <TabControl x:Name="leftTabs"
                        ItemsSource="{Binding LeftTabs}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        SelectedItem="{Binding SelectedLeftTab, Mode=TwoWay}">
              <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
            </TabControl>
            <Button x:Name="LeftAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>

          <GridSplitter Grid.Column="1" x:Name="LeftCenterSplitter" ResizeDirection="Auto"/>

          <!--Center Tabs-->
          <Grid Grid.Column="2" x:Name="CenterPanelGrid">
            <TabControl x:Name="centerTabs"
                        ItemsSource="{Binding CenterTabs}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        SelectedItem="{Binding SelectedCenterTab, Mode=TwoWay}">
              <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
              </TabControl.ItemTemplate>
            </TabControl>

            <Button x:Name="CenterAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
          </Grid>
        </Grid>
        
        <GridSplitter Grid.Row="1" x:Name="CenterBottomSplitter" ResizeDirection="Auto"/>
        
        <!--Bottom Tabs-->
        <Grid Grid.Row="2" x:Name="BottomPanelGrid">
          <TabControl x:Name="bottomTabs"
                      ItemsSource="{Binding BottomTabs}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      SelectedItem="{Binding SelectedBottomTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
          </TabControl>

          <Button x:Name="BottomAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
        </Grid>
      </Grid>

      <GridSplitter Grid.Column="1" x:Name="CenterRightSplitter" ResizeDirection="Auto"/>

      <!--Right Tabs-->
      <Grid Grid.Column="2" x:Name="RightPanelGrid">
        <TabControl x:Name="rightTabs"
                    ItemsSource="{Binding RightTabs}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    SelectedItem="{Binding SelectedRightTab, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <icons:MaterialIcon Kind="{Binding Icon}" Foreground="#888" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </TabControl>

        <Button x:Name="RightAddButton" Content="+" FontSize="14" Width="18" Height="18"
                    Margin="6,6,6,6" Padding="3,-2,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
      </Grid>
    </Grid>
  </DockPanel>
</Window>